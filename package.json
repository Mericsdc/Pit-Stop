{
  "name": "pit-stop",
  "version": "1.2.3",
  "private": true,
  "description": "Pit-Stop — Türkçe Discord topluluk botu",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "register": "node --env-file-if-exists=.env scripts/register-commands.js",
    "invite": "node --env-file-if-exists=.env scripts/invite.js",
    "check": "node scripts/check.js",
    "test": "node --test",
    "build:pages": "node scripts/build-pages.js"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "lavalink-client": "2.11.0"
  }
}
