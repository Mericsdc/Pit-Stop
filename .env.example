# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=
# General Information > Application ID
DISCORD_CLIENT_ID=
# Geliştirme için sunucu kimliği. Boşsa komutlar global kaydedilir.
DISCORD_GUILD_ID=
# Sağlık kontrolü yalnızca 127.0.0.1 üzerinde dinler.
HEALTH_PORT=3000

# Panel: Developer Portal > OAuth2 > Client Secret
DISCORD_CLIENT_SECRET=
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
PUBLIC_URL=http://localhost:3001
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3001
DATA_DIR=./data

# Müzik servisi; boş bırakıldığında diğer bot özellikleri çalışır.
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=
