# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=
# General Information > Application ID
DISCORD_CLIENT_ID=
# Geliştirme için sunucu kimliği. Boşsa komutlar global kaydedilir.
DISCORD_GUILD_ID=
# Sağlık kontrolü yalnızca 127.0.0.1 üzerinde dinler.
HEALTH_PORT=3000

# Panel: Developer Portal > OAuth2 > Client Secret
DISCORD_CLIENT_SECRET=
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
PUBLIC_URL=http://localhost:3001
# GoodbyDPI veya DNS erişim sorunu için ek HTTPS panel kökleri (virgülle ayrılır).
PANEL_ORIGINS=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3001
DATA_DIR=./data
# Login ekranındaki varsayılan hava durumu. Konum izni yalnızca kullanıcı düğmeye basınca istenir.
DEFAULT_WEATHER_CITY=İstanbul
DEFAULT_WEATHER_LATITUDE=41.0082
DEFAULT_WEATHER_LONGITUDE=28.9784

# Müzik servisi; boş bırakıldığında diğer bot özellikleri çalışır.
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=
YOUTUBE_SKIP_INITIALIZATION=true
# Optional self-hosted yt-cipher. Keep the password in the music service environment.
YOUTUBE_CIPHER_URL=
YOUTUBE_CIPHER_PASSWORD=
# Rich Presence oyun takibi. Developer Portal > Presence Intent de açık olmalı.
PRESENCE_ENABLED=false
# Virgülle ayrılmış izinli sunucular. Canlı kurulumda mutlaka tanımlayın.
ALLOWED_GUILD_IDS=
# Kurulum listesini panelde değiştirebilen uygulama sahibi kimlikleri.
BOT_OWNER_IDS=

# NightRiderz Crew Members listesini canlı yenilemek için isteğe bağlı,
# salt-okunur oturum kimlikleri. Boşsa güvenli başlangıç kadrosu kullanılır.
NRZ_USER_KEY=
NRZ_PERSONA_KEY=

# NightRiderz canlı haritasındaki Boosted Event duyurularının varsayılan kanalı.
BOOSTED_EVENT_CHANNEL_ID=
